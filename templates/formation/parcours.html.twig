{% extends 'base.html.twig' %}
{% import '_blocs.html.twig' as b %}

{% block title %}Parcours · Atelier Symfony{% endblock %}

{% block contenu %}
    <h1 class="titre-page">Parcours</h1>
    <p class="sous-titre">Les blocs s'ouvrent dans l'ordre. Un exercice est validé quand ses tests passent.</p>

    {% for niveau in niveaux %}
        <section class="carte carte--grande niveau" aria-labelledby="niveau-{{ niveau.id }}">
            <h2 class="niveau__titre" id="niveau-{{ niveau.id }}">{{ niveau.nom }}</h2>
            <p class="etiquette">{{ niveau.sousTitre }}</p>
            {% for groupe in groupes[niveau.id] %}
                <details class="sujet"{% if groupe.ouvert %} open{% endif %}>
                    <summary>
                        <span class="sujet__resume">{% if groupe.sujet is not null %}Sujet {{ groupe.sujet.numero }} · {{ groupe.sujet.titre }}{% else %}Rappels et lectures{% endif %}</span>
                        <span class="etiquette">{{ groupe.faits }} / {{ groupe.blocs|length }}</span>
                    </summary>
                    <ul class="blocs">
                        {% for bloc in groupe.blocs %}{{ b.ligne(bloc, statuts[bloc.id]) }}{% endfor %}
                    </ul>
                </details>
            {% endfor %}
        </section>
    {% endfor %}
{% endblock %}
