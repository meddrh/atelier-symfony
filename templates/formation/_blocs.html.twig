{# Petits éléments partagés : icône du type de bloc, libellé du type, étiquette d'état, ligne de bloc. #}
{% macro icone(type) %}
    {%- set icones = {preparation: '✎', demonstration: '▶', rappel: '↺', lecture: '☰', exercice: '>_'} -%}
    <span class="bloc__icone" aria-hidden="true">{{ icones[type.value] }}</span>
{% endmacro %}

{% macro libelle(type) %}
    {%- set libelles = {preparation: 'Fiche de préparation', demonstration: 'Démonstration', rappel: 'Rappel', lecture: 'Lecture', exercice: 'Exercice'} -%}
    {{- libelles[type.value] -}}
{% endmacro %}

{% macro etat(statut) %}
    {%- set libelles = {fait: 'Fait', en_cours: 'En cours', verrouille: 'Verrouillé'} -%}
    <span class="etat etat--{{ statut.value|replace({'_': '-'}) }}">{{ libelles[statut.value] }}</span>
{% endmacro %}

{# Bouton « terminer » : un formulaire POST avec son jeton et le budget de la séance avant ce bloc. #}
{% macro terminer(bloc, reste, libelle) %}
    <form method="post" action="{{ path('formation_terminer', {blocId: bloc.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('terminer') }}">
        <input type="hidden" name="reste" value="{{ reste }}">
        <button class="bouton bouton--sombre" type="submit">{{ libelle }}</button>
    </form>
{% endmacro %}

{# Une ligne de bloc : lien si le bloc est ouvert, simple texte s'il est verrouillé.
   Export (« export » vrai, statut inutilisé) : ni état ni verrou, tous les blocs sont des liens. #}
{% macro ligne(bloc, statut, actif = false, export = false) %}
    {% import _self as b %}
    {% set verrouille = not export and statut.value == 'verrouille' %}
    <li class="bloc{% if not export %} bloc--{{ statut.value|replace({'_': '-'}) }}{% endif %}{% if actif %} bloc--actif{% endif %}">
        {{ b.icone(bloc.type) }}
        <span class="bloc__titre">
            {% if verrouille %}{{ bloc.titre }}{% else %}<a href="{{ lien('formation_lecon', {blocId: bloc.id}, export) }}">{{ bloc.titre }}</a>{% endif %}
            <span class="bloc__type">{{ b.libelle(bloc.type) }}</span>
        </span>
        <span class="bloc__duree">{{ bloc.dureeMinutes }} min</span>
        {% if export %}<span></span>{% else %}{{ b.etat(statut) }}{% endif %}
    </li>
{% endmacro %}
